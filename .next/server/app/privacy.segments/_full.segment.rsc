c:["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"The resume optimizer feature sends your career data to a user-configured n8n webhook URL for AI processing. This integration is optional and entirely user-initiated. The webhook URL is stored only in your browser's local storage. Personal contact details (name, email, phone, etc.) are not sent to the webhook — they are injected server-side after the AI response is received."}]
d:["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"6. Data Export and Deletion"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"You can export all your data at any time from the Settings page as a JSON file. You can also delete all your data through the Settings page. These options are available to both authenticated and anonymous users."}]]}]
