7:["$","div",null,{"className":"prose prose-sm dark:prose-invert max-w-none space-y-6","children":[["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"1. Overview"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"CV CMS (\"the Service\") is a headless CMS for managing professional career data. This policy describes what data we collect, how we use it, and your rights regarding that data."}]]}],["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"2. Data We Collect"}],["$","h3",null,{"className":"text-base font-medium","children":"Authentication Data"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"When you sign in via GitHub or Google OAuth, we receive and store your name, email address, and profile picture from the OAuth provider. This data is used solely for authentication and identifying your account."}],["$","h3",null,{"className":"text-base font-medium","children":"Career Data"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"The Service stores the career data you create, including jobs, highlights (achievements, projects, responsibilities), profile information, and associated metadata such as skills, domains, keywords, and metrics."}],["$","h3",null,{"className":"text-base font-medium","children":"Anonymous Usage"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"If you use the Service without signing in, your data is stored locally in your browser using IndexedDB. This data never leaves your device unless you choose to sign in, at which point it is migrated to a cloud database."}]]}],["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"3. How We Store Your Data"}],["$","h3",null,{"className":"text-base font-medium","children":"Authenticated Users"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"Each authenticated user receives a dedicated Turso (libSQL) database. Your career data is isolated in your own database and is not shared with other users."}],["$","h3",null,{"className":"text-base font-medium","children":"Anonymous Users"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"Anonymous users' data is stored in IndexedDB within the browser. This data persists until you clear your browser data or explicitly clear it through the Settings page."}]]}],["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"4. Cookies and Sessions"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"We use only essential cookies required for authentication sessions. We do not use tracking cookies, analytics cookies, or any third-party advertising cookies."}]]}],["$","section",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-lg font-semibold","children":"5. Third-Party Services"}],["$","h3",null,{"className":"text-base font-medium","children":"OAuth Providers"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"We use GitHub and Google as OAuth providers for authentication. Their respective privacy policies apply to data they process during the authentication flow."}],["$","h3",null,{"className":"text-base font-medium","children":"Turso"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":"Authenticated user data is stored in Turso databases. Turso acts as our database provider and processes data on our behalf."}],["$","h3",null,{"className":"text-base font-medium","children":"n8n Webhook Integration"}],"$Lc"]}],"$Ld","$Le"]}]
